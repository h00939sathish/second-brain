# Backend state & lock files
.lock
*.tmp
*.log
meta/search_index.db
sessions/*.json
__pycache__/
*.pyc
.venv/
mcp/.venv/

# Local MCP configs containing API keys
.mcp.json

# Frontend dependencies & build artifacts
node_modules/
build/
dist/
coverage/
.DS_Store
.env
.env.local
.env.production
!.env.example
# brain state (never commit)
.lock
*.tmp
meta/search_index.db*
meta/daemon_heartbeat.json
*/logs/
*.log

# timestamped backups made by `brain setup` before it edits a config
*.brainbak-*

# Attestation trust root: the private key signs the brain's own receipts, so it
# must never be committed. The public key is the pin other agents verify against.
.trust/*
!.trust/attest.pub

# Test-run transcripts can contain command output from arbitrary cwd
workspaces/*/receipts/
